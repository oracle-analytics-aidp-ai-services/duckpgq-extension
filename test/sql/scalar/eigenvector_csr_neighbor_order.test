# name: test/sql/scalar/eigenvector_csr_neighbor_order.test
# description: Exact eigenvector scores are independent of captured CSR neighbor order
# group: [scalar]

require duckpgq

statement ok
SET threads = 1;

# These are two real captured CSR orders. Both have offsets
# [0,6,10,13,15,18,19,20], seven real vertices and two native padding slots.
# Each vertex row contains the same neighbor multiset. Only its order differs.
# Existing creation scalars execute one row per statement, so no input sort or
# planner-dependent vector order can change either captured sequence.

# Captured order A: [5, 6, 1, 2, 3, 4, 4, 0, 2, 3, 1, 4, 0, 1, 0, 0, 1, 2, 0, 0]

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 0::BIGINT, 6::BIGINT);
----
6

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 1::BIGINT, 4::BIGINT);
----
4

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 2::BIGINT, 3::BIGINT);
----
3

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 3::BIGINT, 2::BIGINT);
----
2

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 4::BIGINT, 3::BIGINT);
----
3

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 5::BIGINT, 1::BIGINT);
----
1

query I
SELECT create_csr_vertex(-90131, 7::BIGINT, 6::BIGINT, 1::BIGINT);
----
1

query I
SELECT create_csr_edge(-90131, 7::BIGINT, 20::BIGINT, 20::BIGINT, 0::BIGINT, 5::BIGINT, 0::BIGINT);
----
1

query I
