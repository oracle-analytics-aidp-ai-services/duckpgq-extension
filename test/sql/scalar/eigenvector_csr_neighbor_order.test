# Both columns execute the registered native scalar. QueryEnd then removes
# both CSR owners; the materialized result retains only values.
statement ok
CREATE TEMP TABLE csr_eigen_order_result AS SELECT i AS vertex_id, eigenvector_centrality(-90131, i) AS score_a, eigenvector_centrality(-90132, i) AS score_b FROM range(7) r(i);

query TTT
SELECT typeof(vertex_id), typeof(score_a), typeof(score_b) FROM csr_eigen_order_result LIMIT 1;
----
BIGINT	DOUBLE	DOUBLE

query I
SELECT vertex_id FROM csr_eigen_order_result;
----
0
1
2
3
4
5
6

query III
SELECT count(*), count(DISTINCT vertex_id), count(*) FILTER (WHERE isfinite(score_a) AND isfinite(score_b) AND score_a > 0 AND score_b > 0) FROM csr_eigen_order_result;
----
7	7	7

# Compare inside DuckDB, not SQLLogicTest's formatted floating tolerance.
# For these finite positive doubles, exact inequality detects differing bits.
query I
SELECT count(*) FILTER (WHERE score_a IS DISTINCT FROM score_b) FROM csr_eigen_order_result;
----
0
